# ---------- Backend (copy to backend/.env) ----------
DCS_DATABASE_URL=sqlite:///./digital_crime_scene.db
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/dcs  (also: pip install "psycopg[binary]")
DCS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DCS_RATE_LIMIT_PER_MINUTE=120
DCS_ASSISTANT_RATE_LIMIT_PER_MINUTE=20

# Optional LLM (any OpenAI-compatible /chat/completions endpoint). Leave blank to stay fully offline.
# The key lives ONLY on the server and is never sent to the browser.
DCS_LLM_BASE_URL=
DCS_LLM_API_KEY=
DCS_LLM_MODEL=

# ---------- Frontend (copy to frontend/.env) ----------
# Leave blank to run fully offline (localStorage only). Public value; never put secrets here.
VITE_API_URL=http://localhost:8000
